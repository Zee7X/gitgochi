{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gitgotchi": {
      "type": "stdio",
      "command": "node",
      "args": ["server/gitgotchi-mcp.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": { "GITGOTCHI_URL": "http://localhost:3000" }
    }
  }
}
