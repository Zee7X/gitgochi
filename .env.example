# GitGotchi environment. Copy to .env.local and fill in what you need.
# Nothing here is required to try the demo pets (demo/healthy, demo/neglected, demo/haunted).
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- GitHub (public reads) ---

# Fine-grained personal access token: public repositories, read-only, NO scopes.
# Used for visitors who are not signed in. Without it GitHub allows 60 requests per hour per IP and one
# adoption costs about 4, so real repos hit "github rate limit reached" quickly. REQUIRED when deployed.
# Private repos are never read with this token for anyone outside the repo.
GITHUB_TOKEN=

# Shared secret for a manual repo webhook (POST /api/webhook/github). Kept for repos set up before the
# GitGotchi App; new repos install the app instead.
GITHUB_WEBHOOK_SECRET=

# --- GitGotchi GitHub App (sign in, keepers, private repos, live webhooks) ---
# Register the app once with /setup/github-app?token=<SETUP_TOKEN> (docs/DEPLOY.md), then fill these in.
# Without them the app works as before: public pets, read-only for everyone, no sign in.

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# PEM private key of the app. Literal \n line breaks are accepted.
GITHUB_APP_PRIVATE_KEY=

# Encrypts sessions (user tokens). Random, 32 bytes or more.
SESSION_SECRET=
# Encrypts private pets before they reach the store. Random, 32 bytes or more. Losing it makes stored
# private pets unreadable; they re-seed from GitHub on the next visit.
DATA_ENCRYPTION_KEY=
# Public origin of the deployment, used for the sign-in callback and the same-origin check.
APP_ORIGIN=http://localhost:3000
# Unlocks /setup/github-app while you register the app. Remove it afterwards.
SETUP_TOKEN=

# --- Pet store (Upstash Redis REST) ---

# Pets persist in Upstash Redis when a URL + token pair is set. The UPSTASH_* pair wins; the KV_REST_API_* pair
# (injected by the Vercel Marketplace Upstash integration) is used when the UPSTASH_* pair is incomplete.
# With neither pair, pets live in server memory and a restart or cold start loses them (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Kiro hooks and MCP server ---

# Base URL of the running app. Read by scripts/poop-detector.mjs and mcp-server/index.mjs.
# Default: http://localhost:3000
GITGOTCHI_URL=http://localhost:3000

# Repo key (owner/repo) the poop-detector hook reports to. Default: the git "origin" remote.
GITGOTCHI_REPO=

# Hook token. Two kinds are accepted:
# - a per-pet token from KEEPER TOOLS on the pet page (ggh_...): works for that one pet only, on a deployed app;
# - on your own server, any value you also set there as GITGOTCHI_HOOK_TOKEN: works for every pet.
# The hook script and the MCP server send it automatically when this variable is set.
GITGOTCHI_HOOK_TOKEN=
