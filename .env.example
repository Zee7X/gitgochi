# GitGotchi environment. Copy to .env.local and fill in what you need.
# Nothing here is required to try the demo pets (demo/healthy, demo/neglected, demo/haunted).

# --- GitHub ---

# Fine-grained personal access token: public repositories, read-only, NO scopes.
# Without it GitHub allows 60 requests per hour per IP and one adoption costs about 4,
# so real repos hit "github rate limit reached" quickly. REQUIRED for any deployed instance (5000/hour).
# Also used by the Summon Kiro diagnosis (src/lib/heal.ts).
GITHUB_TOKEN=

# Shared secret for the GitHub webhook. When set, POST /api/webhook/github checks
# X-Hub-Signature-256 and answers 401 on a mismatch. When empty, unsigned requests are accepted.
# Use the same value in the webhook settings on GitHub.
GITHUB_WEBHOOK_SECRET=

# --- Pet store (Upstash Redis REST) ---

# Pets persist in Upstash Redis when a URL + token pair is set. The UPSTASH_* pair wins; the KV_REST_API_* pair
# (injected by the Vercel Marketplace Upstash integration) is used when the UPSTASH_* pair is incomplete.
# With neither pair, pets live in server memory and a restart or cold start loses them (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Kiro hooks and MCP server (local development) ---

# Base URL of the running app. Read by scripts/poop-detector.mjs and mcp-server/index.mjs.
# Default: http://localhost:3000
GITGOTCHI_URL=http://localhost:3000

# Repo key (owner/repo or demo/name) the poop-detector hook reports to.
# Default for the hook: the git "origin" remote; the server then falls back to demo/healthy.
GITGOTCHI_REPO=demo/healthy

# Bearer token for POST /api/local-poop from non-local callers. Without it only localhost is accepted,
# and that check trusts the Host header, so set a token whenever the app is reachable from outside.
# The hook script sends it automatically when this variable is set.
GITGOTCHI_HOOK_TOKEN=
