{
  "$schema": "https://kiro.dev/schemas/hook.schema.json",
  "name": "poop-detector",
  "description": "Deteksi console.log, debugger, dan TODO saat berkas .ts/.tsx disimpan, lalu pemicu kemunculan poop/hantu kecil di layar GitGotchi",
  "trigger": {
    "event": "onFileSave",
    "pattern": "**/*.{ts,tsx}"
  },
  "action": {
    "type": "httpPost",
    "url": "http://localhost:3000/api/local-poop",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "filePath": "${file.path}",
      "hasConsoleLog": "${file.contains('console.log')}",
      "hasTodo": "${file.contains('TODO:')}",
      "timestamp": "${system.timestamp}"
    }
  }
}
