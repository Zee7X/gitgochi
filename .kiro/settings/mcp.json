{
  "mcpServers": {
    "gitgotchi": {
      "command": "node",
      "args": [
        "mcp-server/index.mjs"
      ],
      "env": {
        "GITGOTCHI_URL": "http://localhost:3000",
        "GITGOTCHI_PUBLIC_URL": "https://gitgochi.lumelo.my.id"
      },
      "disabled": false,
      "autoApprove": [
        "get_pet_status",
        "diagnose_pet"
      ]
    }
  }
}
